import {Definition} from './Types';
const DESCRIPTIONS:Record<string,string>={};
DESCRIPTIONS['click']='点击最新截图中指定的屏幕位置，坐标为0–1000比例。返回命中的文字（或空白处）和动作后屏幕是否变化；效果以下次观察为准。';
DESCRIPTIONS['long_press']='在指定位置长按，坐标0–1000。返回命中与屏幕变化反馈。';
DESCRIPTIONS['double_click']='在指定位置双击，坐标0–1000。返回命中与屏幕变化反馈。';
DESCRIPTIONS['drag']='从起点拖到终点，坐标均为0–1000。返回起点命中与屏幕变化反馈；需要精确落点时先observe。';
DESCRIPTIONS['scroll']='按方向滚动页面，最多8次；给出untilText时找到即停止。返回滚动次数与是否找到，随后observe确认。';
DESCRIPTIONS['press_key']='按一个系统键：enter、backspace、tab、escape。返回发送结果，效果以下次观察为准。';
DESCRIPTIONS['swipe']='在最新屏幕上从起点滑到终点。坐标为0–1000；用于滚动或切换页面，返回实际执行结果。';
DESCRIPTIONS['back']='执行一次系统返回，用于关闭当前页面或返回上层；返回命令结果，随后观察实际页面。';
DESCRIPTIONS['home']='回到系统桌面，用于切换任务入口；返回命令结果，随后观察桌面。';
DESCRIPTIONS['observe']='读取当前屏幕截图、可见元素和已发现应用。可选query只列出文字、描述、类型或编号包含该词的元素（不截断）。返回最新snapshotId与元素编号。第三方应用读不到文字（画面是图片、画布、网页渲染）时，用ocr:true让端侧OCR识别截图，识别出的文字与坐标以type=ocr的元素列出，可按其normalizedCenter点击；可读文字很少或模型不支持视觉时系统也会自动识别。';
DESCRIPTIONS['insert_text']='在指定坐标的输入框光标处插入文字，保留已有内容；返回输入结果与验证状态。密码交用户输入。';
DESCRIPTIONS['replace_text']='定位指定坐标输入框并全选替换已有文字；仅用于明确替换任务，返回实际结果与验证状态。';
DESCRIPTIONS['skill_load']='按可用目录中的名字加载Skill正文，或按相对path读取包内文本参考资料。返回指令资料，附带脚本不执行。';
DESCRIPTIONS['request_confirmation']='仅用于危险动作的确认（发送、付款、删除、安装卸载、改系统设置等），text写清具体动作及影响。需要用户选择或补充信息时用 ask_user，不要用本工具。设备危险操作由执行器自动确认，无需重复调用。';
DESCRIPTIONS['click_element']='按最新快照中的元素编号重新定位并点击唯一可用目标。返回实际结果；目标消失/重复/旧快照时返回明确错误。无标签目标用最新截图坐标。';
DESCRIPTIONS['insert_element']='重新定位可编辑元素并在光标处插入文字，保留原文；返回输入结果和可读文本验证状态。';
DESCRIPTIONS['replace_element']='重新定位可编辑元素并替换全部文本；返回输入结果与验证状态，未验证时不要自动重输。';
DESCRIPTIONS['wait_for']='按条件等待：textAppears（targetText出现）、textDisappears（消失）、screenChanges（屏幕内容变化）。默认10秒、最多30秒，每500ms检查；超时返回TIMEOUT。';
DESCRIPTIONS['launch_app']='启动当前观察中已发现的appId，不接受任意命令。返回启动结果和前台校验。';
DESCRIPTIONS['finish_task']='结束当前任务，outcome为success/blocked/needs_user，reply为给用户的结果；可选附最新snapshotId和evidence。若操作过第三方应用，reply末尾说明平板停留在哪个应用的哪个页面，便于用户接手。';
DESCRIPTIONS['file_list']='列出当前会话全部文件（导入与生成）：fileId、文件名、类型、大小、来源（导入/生成）、生成它的工具调用编号与验证状态；没有文件时说明没有。opaque文件只能另存，不能解析。';
DESCRIPTIONS['sheet_list']='读取当前会话.xlsx的工作表名称列表，供sheet_read定位。';
DESCRIPTIONS['sheet_read']='按fileId和工作表名称读取最多100个原始单元格；offset继续分页。返回单元格、合并区和下一偏移；公式不重算。';
DESCRIPTIONS['sheet_create']='按rowsJson二维数据新建.xlsx，返回新fileId和验证信息；公式仅作为普通文本，不覆盖原件。';
DESCRIPTIONS['sheet_update_cells']='按patchesJson修改已读取工作表的指定单元格，另存新.xlsx并验证；返回新fileId，不写公式、不改原件。';
DESCRIPTIONS['presentation_read']='读取当前会话PPT的指定页，返回标题、段落文字和paragraphId；页码从1开始。';
DESCRIPTIONS['presentation_create']='按slidesJson新建基础文字PPT并验证，返回新fileId；不承诺高级图形与版式。';
DESCRIPTIONS['presentation_set_text']='替换已读取PPT中指定paragraphId的文字，另存并验证，返回新fileId；原件保留。';
DESCRIPTIONS['submit_plan']='保存1–20步计划草案及依赖和验收标准，返回计划编号；保存不会执行。';
DESCRIPTIONS['update_plan_step']='更新已批准计划的步骤状态，返回持久化结果；完成时提供实际证据。';
const PARAMETERS:Record<string,string>={};
PARAMETERS['x']='起点/目标横坐标，屏幕比例0–1000';
PARAMETERS['y']='起点/目标纵坐标，屏幕比例0–1000';
PARAMETERS['x2']='滑动终点横坐标，屏幕比例0–1000';
PARAMETERS['y2']='滑动终点纵坐标，屏幕比例0–1000';
PARAMETERS['snapshotId']='最近observe返回的快照编号，页面变化后须重新观察';
PARAMETERS['elementId']='该快照中可见元素临时编号，不使用历史编号';
PARAMETERS['text']='实际要输入、替换、匹配或询问的完整文字；不提供密码';
PARAMETERS['name']='当前目录中的Skill名字或另存结果文件名';
PARAMETERS['path']='Skill包内相对文本路径；省略则读取正文';
PARAMETERS['condition']='textAppears文字出现、textDisappears文字消失、screenChanges屏幕内容变化（旧值appears/disappears/text仅兼容元素编号等待）';
PARAMETERS['query']='observe 的过滤词，只列出文字、描述、类型或编号包含它的元素';
PARAMETERS['direction']='滚动方向 up/down/left/right，down 表示查看下方内容';
PARAMETERS['untilText']='滚动时出现即停止的文字';
PARAMETERS['maxSwipes']='最多滑动次数，1–8';
PARAMETERS['key']='系统键：enter/backspace/tab/escape';

PARAMETERS['targetText']='预期匹配的可读文字，可替代elementId用于等待';
PARAMETERS['timeoutMs']='等待毫秒数，默认10000，最大30000';
PARAMETERS['appId']='当前观察已发现的完整应用标识';
PARAMETERS['outcome']='success成功、blocked受阻、needs_user需要用户处理';
PARAMETERS['reply']='给用户的结果说明';
PARAMETERS['evidence']='已核实事实或未验证项说明';
PARAMETERS['stepId']='submit_plan返回的步骤编号';
PARAMETERS['stepStatus']='pending/running/completed/blocked';
PARAMETERS['sheet']='工作表名称；创建时默认Sheet1';
export function describeTools(defs:Definition[]):Definition[]{defs.forEach(d=>{if(DESCRIPTIONS[d.name])d.description=DESCRIPTIONS[d.name];Object.keys(d.parameters.properties).forEach(k=>{const p=d.parameters.properties[k];if(!p.description)p.description=PARAMETERS[k]??('工具参数 '+k+'，类型'+p.type);});});return defs;}
