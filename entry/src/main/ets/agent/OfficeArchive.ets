import {buffer} from '@kit.ArkTS';
export interface ZipEntry {name:string;size:number;}
export interface BinaryPart {name:string;data:Uint8Array;}
function u16(a:Uint8Array,p:number):number{if(p<0||p+2>a.length)throw new Error('ZIP截断');return a[p]+a[p+1]*256;}
function u32(a:Uint8Array,p:number):number{return u16(a,p)+u16(a,p+2)*65536;}
export function safePart(name:string):boolean{return !!name&&!name.startsWith('/')&&!/[\\:\u0000]/.test(name)&&!name.split('/').some(s=>!s||s==='.'||s==='..');}
export function inspectOfficeZip(data:Uint8Array):ZipEntry[]{let end=-1;for(let p=data.length-22;p>=Math.max(0,data.length-65557);p--){if(u32(data,p)===0x06054b50&&p+22+u16(data,p+20)===data.length){end=p;break;}}if(end<0||u16(data,end+4)||u16(data,end+6))throw new Error('Office ZIP无效或分卷');const count=u16(data,end+10),start=u32(data,end+16),length=u32(data,end+12);if(!count||count>512||u16(data,end+8)!==count||start+length!==end)throw new Error('Office ZIP目录超限或无效');const entries:ZipEntry[]=[];let position=start,total=0;for(let i=0;i<count;i++){if(u32(data,position)!==0x02014b50)throw new Error('Office ZIP目录无效');const n=u16(data,position+28),extra=u16(data,position+30),comment=u16(data,position+32);if(position+46+n+extra+comment>end)throw new Error('Office ZIP目录截断');const raw=buffer.from(data.slice(position+46,position+46+n)).toString('utf8');const name=raw.replace(/\/$/,'');if(!safePart(name)||entries.some(e=>e.name.toLowerCase()===name.toLowerCase()))throw new Error('Office ZIP路径无效或重复');if((u16(data,position+40)&0xf000)===0xa000)throw new Error('Office ZIP含符号链接');if(u16(data,position+8)&1||![0,8].includes(u16(data,position+10)))throw new Error('Office ZIP加密或压缩格式不支持');const size=u32(data,position+24);total+=size;if(size>10*1024*1024||total>40*1024*1024)throw new Error('Office ZIP解压大小超限');const local=u32(data,position+42);if(local>=start||u32(data,local)!==0x04034b50)throw new Error('Office ZIP本地头无效');const ln=u16(data,local+26),le=u16(data,local+28);if(buffer.from(data.slice(local+30,local+30+ln)).toString('utf8')!==raw||local+30+ln+le+u32(data,position+20)>start)throw new Error('Office ZIP本地内容无效');entries.push({name:name,size:size});position+=46+n+extra+comment;}if(position!==end)throw new Error('Office ZIP目录大小不一致');return entries;}
const crcTable:number[]=[];for(let i=0;i<256;i++){let c=i;for(let j=0;j<8;j++)c=c&1?0xedb88320^(c>>>1):c>>>1;crcTable.push(c>>>0);}
function crc(data:Uint8Array):number{let c=0xffffffff;for(let i=0;i<data.length;i++)c=crcTable[(c^data[i])&255]^(c>>>8);return (c^0xffffffff)>>>0;}
function w16(a:Uint8Array,p:number,v:number):void{a[p]=v&255;a[p+1]=(v>>>8)&255;}
function w32(a:Uint8Array,p:number,v:number):void{w16(a,p,v&65535);w16(a,p+2,(v>>>16)&65535);}
// Store entries without compression: deterministic, no platform ZIP root-folder
// ambiguity. Office content/relationships remain intact; source archive is kept.
export function packOffice(parts:BinaryPart[]):Uint8Array{if(!parts.length||parts.length>512)throw new Error('Office文件数量超限');const locals:Uint8Array[]=[],central:Uint8Array[]=[];let offset=0;const names:string[]=[];parts.forEach(part=>{if(!safePart(part.name)||names.includes(part.name))throw new Error('Office输出路径无效');names.push(part.name);const encoded=buffer.from(part.name,'utf8');const bytes:number[]=[];for(let i=0;i<encoded.length;i++)bytes.push(encoded.readUInt8(i));const label=new Uint8Array(bytes);const data=part.data,checksum=crc(data);const local=new Uint8Array(30+label.length+data.length);w32(local,0,0x04034b50);w16(local,4,20);w16(local,6,0x0800);w16(local,12,33);w32(local,14,checksum);w32(local,18,data.length);w32(local,22,data.length);w16(local,26,label.length);local.set(label,30);local.set(data,30+label.length);const dir=new Uint8Array(46+label.length);w32(dir,0,0x02014b50);w16(dir,4,20);w16(dir,6,20);w16(dir,8,0x0800);w16(dir,14,33);w32(dir,16,checksum);w32(dir,20,data.length);w32(dir,24,data.length);w16(dir,28,label.length);w32(dir,42,offset);dir.set(label,46);locals.push(local);central.push(dir);offset+=local.length;if(offset>45*1024*1024)throw new Error('Office输出大小超限');});const centralSize=central.reduce((n:number,a:Uint8Array)=>n+a.length,0),out=new Uint8Array(offset+centralSize+22);let p=0;locals.concat(central).forEach(a=>{out.set(a,p);p+=a.length;});w32(out,p,0x06054b50);w16(out,p+8,parts.length);w16(out,p+10,parts.length);w32(out,p+12,centralSize);w32(out,p+16,offset);return out;}
