import {fileIo as fs,picker} from '@kit.CoreFileKit';
import {zlib} from '@kit.BasicServicesKit';
import {buffer} from '@kit.ArkTS';
import {common} from '@kit.AbilityKit';
import {Skill,uid} from './Types';
import {Store} from './Store';
export function safePath(path:string):boolean{return path.length>0&&!path.startsWith('/')&&!path.includes('\\')&&!path.includes(':')&&!path.split('/').some(s=>s==='..'||s==='.'||s==='');}
function u16(a:Uint8Array,p:number):number{if(p+2>a.length)throw new Error('ZIP 目录截断');return a[p]+a[p+1]*256;}
function u32(a:Uint8Array,p:number):number{return u16(a,p)+u16(a,p+2)*65536;}
export function inspectZip(data:Uint8Array):void{let eocd=-1;for(let p=data.length-22;p>=Math.max(0,data.length-65557);p--){if(u32(data,p)===101010256){eocd=p;break;}}if(eocd<0)throw new Error('ZIP 目录无效');if(u16(data,eocd+4)||u16(data,eocd+6))throw new Error('不支持分卷 ZIP');const count=u16(data,eocd+10);if(!count||count>128)throw new Error('ZIP 文件数量超限');let pos=u32(data,eocd+16),total=0;for(let i=0;i<count;i++){if(u32(data,pos)!==33639248)throw new Error('ZIP 目录无效');const len=u16(data,pos+28),extra=u16(data,pos+30),comment=u16(data,pos+32);if(pos+46+len+extra+comment>eocd)throw new Error('ZIP 目录截断');const raw=buffer.from(data.slice(pos+46,pos+46+len)).toString('utf8');const name=raw.replace(/\/$/,'');if(!safePath(name))throw new Error('ZIP 包含不安全路径');if((u16(data,pos+40)&61440)===40960)throw new Error('ZIP 不支持符号链接');if(u16(data,pos+8)&1)throw new Error('ZIP 不支持加密');if([0,8].indexOf(u16(data,pos+10))<0)throw new Error('ZIP 压缩方式不支持');const size=u32(data,pos+24);total+=size;if(total>20*1024*1024)throw new Error('ZIP 解压大小超限');const local=u32(data,pos+42);if(u32(data,local)!==67324752)throw new Error('ZIP 本地目录无效');const localName=buffer.from(data.slice(local+30,local+30+u16(data,local+26))).toString('utf8');if(raw!==localName)throw new Error('ZIP 目录路径不一致');pos+=46+len+extra+comment;}if(pos>eocd)throw new Error('ZIP 目录大小无效');}

export class Skills {
 store:Store;constructor(store:Store){this.store=store;}
 async import(context:common.UIAbilityContext):Promise<Skill>{const selected=await new picker.DocumentViewPicker(context).select({maxSelectNumber:1,fileSuffixFilters:['Skill|.md,.zip']});if(!selected.length)throw new Error('未选择文件');const f=fs.openSync(selected[0],fs.OpenMode.READ_ONLY);let data:ArrayBuffer;try{const size=fs.statSync(f.fd).size;if(size>5*1024*1024)throw new Error('导入文件不能超过 5 MB');data=new ArrayBuffer(size);fs.readSync(f.fd,data);}finally{fs.closeSync(f.fd);}const folder=this.store.root+'/skill-'+uid();fs.mkdirSync(folder);let entry='';if(new Uint8Array(data)[0]===80&&new Uint8Array(data)[1]===75){inspectZip(new Uint8Array(data));const zip=folder+'/import.zip';const out=fs.openSync(zip,fs.OpenMode.CREATE|fs.OpenMode.READ_WRITE);try{fs.writeSync(out.fd,data);}finally{fs.closeSync(out.fd);}await zlib.decompressFile(zip,folder);fs.unlinkSync(zip);const entries=fs.listFileSync(folder,{recursion:true});entry=entries.find(p=>p==='SKILL.md'||p.endsWith('/SKILL.md'))??'';if(!entry)throw new Error('ZIP 缺少 SKILL.md');}else{entry='SKILL.md';this.store.write(folder+'/'+entry,buffer.from(data).toString('utf8'));}
 const body=this.store.read(folder+'/'+entry);const header=body.match(/^---\s*\n([\s\S]*?)\n---/);const meta=header?.[1]??'';const name=meta.match(/^name:\s*["']?([^\n"']+)/m)?.[1]?.trim()??entry;const desc=meta.match(/^description:\s*["']?([^\n"']+)/m)?.[1]?.trim()??'导入的任务指导';const files=fs.listFileSync(folder,{recursion:true});const refs=files.filter(p=>safePath(p)&&/\.(md|txt|json|yaml|yml)$/i.test(p)&&p!==entry);return {id:uid(),name:name,description:desc,body:body,enabled:!/^disable-model-invocation:\s*(true|yes|on|1)\s*$/im.test(meta),references:refs,folder:folder,scripts:files.some(p=>/\.(py|sh|js|ts|ps1|exe)$/i.test(p))};
 }
 remove(skill:Skill):void{if(skill.folder==='builtin')return;const prefix=this.store.root+'/skill-';if(!skill.folder.startsWith(prefix)||skill.folder.slice(prefix.length).includes('/')||skill.folder.includes('..'))throw new Error('Skill 目录无效');if(fs.accessSync(skill.folder))fs.rmdirSync(skill.folder);}
 load(skill:Skill,path?:string):string{if(!skill.enabled)throw new Error('Skill 未启用');if(!path)return skill.body+'\n参考资料：'+skill.references.join(', ')+'\n脚本：'+(skill.scripts?'包含依赖脚本，本版不执行':'无');if(!safePath(path)||skill.references.indexOf(path)<0)throw new Error('参考资料路径无效');return this.store.read(skill.folder+'/'+path).slice(0,24000);}
}

export function calculatorSkill():Skill{return {id:'builtin-calculator',name:'原生计算器操作要点',description:'使用原生计算器时加载：清空旧表达式，逐键计算并核对显示。',body:'计算器有旧表达式时先清除并观察为空或 0，再逐键输入。看清数字、运算符和等号，不能把表达式输入不可编辑显示区域。计算后观察实际显示；已得到结果时不要反复清除。',enabled:true,references:[],folder:'builtin',scripts:false};}
