import {BinaryPart} from './OfficeArchive';
import {PartReader,slides,SlideSpec,partPath} from './OfficeFormats';
import {newPresentation} from './PresentationParts';
import {parseXml,descendants,child,escapeXml} from './OfficeXml';
function relPath(path:string):string{return path.replace(/\/([^/]+)$/,'/_rels/$1.rels');}
export function removeSlide(parts:BinaryPart[],reader:PartReader,index:number,bytes:(text:string)=>Uint8Array):void {const list=slides(reader);if(list.length<=1)throw new Error('不能删除唯一一页');if(!Number.isInteger(index)||index<1||index>list.length)throw new Error('页码无效');const xml=reader.read('ppt/presentation.xml');const n=descendants(parseXml(xml),'sldId')[index-1];const p=parts.find(p=>p.name==='ppt/presentation.xml')!;p.data=bytes(xml.slice(0,n.start)+xml.slice(n.end));}
export function appendSlide(parts:BinaryPart[],reader:PartReader,spec:SlideSpec,bytes:(text:string)=>Uint8Array):string {if(slides(reader).length>=20)throw new Error('PPT 最多20页');const made=newPresentation([spec]);let n=1;while(parts.some(p=>p.name==='ppt/slides/slide'+n+'.xml'))n++;const path='ppt/slides/slide'+n+'.xml';parts.push({name:path,data:bytes(made['ppt/slides/slide1.xml'])});const first=slides(reader)[0];const firstRel=reader.read(relPath(first));const layout=descendants(parseXml(firstRel),'Relationship').find(r=>r.attrs.Type.endsWith('/slideLayout'));if(!layout||layout.attrs.TargetMode==='External')throw new Error('原PPT布局引用缺失或为外部目标');const layoutPath=partPath('ppt/slides',layout.attrs.Target);if(!reader.exists(layoutPath))throw new Error('原PPT布局部件缺失');parts.push({name:relPath(path),data:bytes('<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="'+escapeXml(layout.attrs.Type)+'" Target="'+escapeXml(layout.attrs.Target)+'"/></Relationships>')});
 const xml=reader.read('ppt/presentation.xml');const root=parseXml(xml);const list=child(root,'sldIdLst');if(!list||xml.slice(list.start,list.end).endsWith('/>'))throw new Error('PPT页列表无效');let id=256;descendants(root,'sldId').forEach(s=>id=Math.max(id,Number(s.attrs.id)+1));const relId='whaleSlide'+n;parts.find(p=>p.name==='ppt/presentation.xml')!.data=bytes(xml.slice(0,list.innerEnd)+'<p:sldId id="'+id+'" r:id="'+relId+'"/>'+xml.slice(list.innerEnd));
 const rs=reader.read('ppt/_rels/presentation.xml.rels');if(descendants(parseXml(rs),'Relationship').some(r=>r.attrs.Id===relId))throw new Error('PPT关系编号冲突');parts.find(p=>p.name==='ppt/_rels/presentation.xml.rels')!.data=bytes(rs.replace('</Relationships>','<Relationship Id="'+relId+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide" Target="slides/slide'+n+'.xml"/></Relationships>'));
 const ct=reader.read('[Content_Types].xml');parts.find(p=>p.name==='[Content_Types].xml')!.data=bytes(ct.replace('</Types>','<Override PartName="/'+path+'" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slide+xml"/></Types>'));return path;
}
export function insertSlideImage(parts:BinaryPart[],reader:PartReader,index:number,image:Uint8Array,extension:string,bytes:(text:string)=>Uint8Array):void {
 const path=slides(reader)[index-1];if(!path||!Number.isInteger(index))throw new Error('图片页码无效');if(!['png','jpeg'].includes(extension)||!image.length||image.length>10*1024*1024)throw new Error('PPT图片只支持10MB内PNG/JPEG');
 let n=1;while(parts.some(p=>p.name==='ppt/media/whale'+n+'.'+extension))n++;const file='whale'+n+'.'+extension;parts.push({name:'ppt/media/'+file,data:image});const rp=relPath(path),relId='whaleImage'+n;const rels=reader.read(rp);if(descendants(parseXml(rels),'Relationship').some(r=>r.attrs.Id===relId))throw new Error('PPT图片关系冲突');parts.find(p=>p.name===rp)!.data=bytes(rels.replace('</Relationships>','<Relationship Id="'+relId+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="../media/'+file+'"/></Relationships>'));
 const xml=reader.read(path),tree=descendants(parseXml(xml),'spTree')[0];if(!tree)throw new Error('PPT形状树缺失');let id=1;descendants(parseXml(xml),'cNvPr').forEach(p=>id=Math.max(id,Number(p.attrs.id)+1));const pic='<p:pic><p:nvPicPr><p:cNvPr id="'+id+'" name="Whale image"/><p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="'+relId+'"/><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr><a:xfrm><a:off x="6700000" y="2300000"/><a:ext cx="4500000" cy="3200000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr></p:pic>';parts.find(p=>p.name===path)!.data=bytes(xml.slice(0,tree.innerEnd)+pic+xml.slice(tree.innerEnd));
 const ct=reader.read('[Content_Types].xml');if(!descendants(parseXml(ct),'Default').some(t=>t.attrs.Extension===extension))parts.find(p=>p.name==='[Content_Types].xml')!.data=bytes(ct.replace('</Types>','<Default Extension="'+extension+'" ContentType="image/'+extension+'"/></Types>'));
}
