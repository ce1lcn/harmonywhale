 async spillLayout(session:Session,full:string):Promise<string>{
  const threshold:number=thresholdOf(this.state.spillThreshold);
  if(full.length<=threshold)return full;
  try{
   const asset=await this.files.spillText(session,'layout',full,undefined,'layout');
   const p:SpillPreview=headTail(full);
   return p.preview+'\n\n'+spillNotice(asset.id,asset.name,p)+'（每行一个元素；只保留最新一份布局文件。也可用 observe 的 query 直接查找元素。）';
  }catch(e){return full;}
 }
 // ---- 0.8.4 B5：每个工具单独的时限。超时后这次调用返回 TIMEOUT（可重试），任务继续。底层操作无法真正中断，只是不再等它；
 // 设备工具超时使旧命令世代失效并拒绝在途等待；已下发的系统命令不保证停止。轮询类操作自带期限。timeoutOverride 供测试使用。
 timeoutOverride:((name:string,args:Arguments)=>number|undefined)|null=null;
 cancelWaiters:Set<()=>void>=new Set<()=>void>();
 async interruptible<T>(work:Promise<T>,generation:number=this.generation):Promise<T>{
  if(generation!==this.generation)throw new DeviceError('INTERRUPTED','任务已暂停');
  let abort:()=>void=()=>{};
  try{return await new Promise<T>((resolve:(value:T)=>void,reject:(error:Error)=>void)=>{
   abort=():void=>{reject(new DeviceError('INTERRUPTED','任务已暂停') as Error);};this.cancelWaiters.add(abort);
   work.then(resolve,reject);
  });}finally{this.cancelWaiters.delete(abort);}
