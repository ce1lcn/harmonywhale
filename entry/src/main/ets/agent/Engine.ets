 toolTimeoutMs(name:string,args:Arguments):number{const o:number|undefined=this.timeoutOverride?this.timeoutOverride(name,args):undefined;return o!==undefined?o:toolTimeout(name,args.ocr===true,args.timeoutMs);}
 async guardedTool<T>(name:string,args:Arguments,fn:()=>Promise<T>):Promise<T>{
  const ms:number=this.toolTimeoutMs(name,args);
  if(!(ms>0))return fn();
  let timer:number=0;
  try{
   return await this.interruptible(new Promise<T>((resolve:(value:T)=>void,reject:(error:Error)=>void)=>{
    let settled:boolean=false;const began:number=Date.now();
    // 用真实流逝时间判断，定时器每秒最多醒一次：测试环境会把定时器加速，不能让加速的定时器提前触发超时。
    const tick=():void=>{if(settled)return;const spent:number=Date.now()-began;if(spent>=ms){settled=true;if(this.definitions.some(d=>d.name===name&&d.source==='平板内置')&&LOCAL_TOOL_NAMES.indexOf(name)<0&&['skill_load','request_confirmation','finish_task','submit_plan'].indexOf(name)<0&&this.device.cancelCommands)this.device.cancelCommands();if(name==='web_download'||name==='pdf_create'||name.startsWith('document_')||name.startsWith('zip_')||name.startsWith('image_'))this.files.cancel();reject(new DeviceError('TIMEOUT',name+' 超过 '+(ms>=1000?Math.round(ms/1000)+' 秒':ms+' 毫秒')+'仍未完成，已取消') as Error);return;}timer=setTimeout(tick,Math.min(1000,Math.max(1,ms-spent)));};
    timer=setTimeout(tick,Math.min(1000,ms));
    fn().then((value:T)=>{if(settled)return;settled=true;resolve(value);},(error:Error)=>{if(settled)return;settled=true;reject(error);});
   }));
  }finally{clearTimeout(timer);}
 }
 // ---- 0.8.4 B2：只读工具并行。本轮开头连续的并发安全调用（至多 PARALLEL_LIMIT 个、至少 2 个）同时开跑；
 // 之后仍按模型给出的顺序逐个“取用”结果、写回记录，所以界面、上下文里的顺序不变。遇到设备或写入工具就是屏障，它和后面的调用都串行。
 prefetchReads(calls:Call[],records:ToolRecord[],definitions:Definition[],session:Session,generation:number,budget:number):Map<string,EarlyRun>{
  const early:Map<string,EarlyRun>=new Map<string,EarlyRun>();
  const picked:Prefetch[]=[];
  const limit:number=Math.min(PARALLEL_LIMIT,Math.max(0,budget));
  for(let i=0;i<calls.length&&picked.length<limit;i++){
   const call:Call=calls[i];
   const def:Definition|undefined=definitions.find((d:Definition)=>d.name===call.name&&d.enabled);
   if(!def||!isParallelSafe(call.name))break;
   let args:Arguments;
   try{args=JSON.parse(call.arguments) as Arguments;validate(def,args);}catch(e){break;}
   picked.push({call:call,record:records[i],def:def,args:args} as Prefetch);
  }
  if(picked.length<2)return early;
  const jobs:(()=>Promise<EarlyResult>)[]=picked.map((p:Prefetch):(()=>Promise<EarlyResult>)=>():Promise<EarlyResult>=>this.runEarly(p.call,p.def,p.args,session,generation));
  const runs:Promise<EarlyResult>[]=runLimited<EarlyResult>(jobs,PARALLEL_LIMIT);
  picked.forEach((p:Prefetch,i:number)=>{p.record.status='pending';p.record.result='';p.record.parallel=picked.length;runs[i].catch(()=>{});early.set(p.call.id,{promise:runs[i]} as EarlyRun);});
  return early;
 }
 async runEarly(call:Call,def:Definition,args:Arguments,session:Session,generation:number):Promise<EarlyResult>{
  if(generation!==this.generation)throw cancelledError();
  const began:number=Date.now();const sink:WebSource[]=[];let output:string='';
  if(call.name==='skill_load'){const skill=this.state.skills.find((s:Skill)=>s.name===args.name);if(!skill)throw new Error('Skill 不存在');output=this.skills.load(skill,args.path);}
  else if(def.source==='联网')output=await this.guardedTool(call.name,args,()=>this.network.execute(call.name,args,sink));
  else if(def.source==='本机文件')output=await this.guardedTool(call.name,args,()=>this.files.execute(call.name,args,session,call.id));
  else output=await this.guardedTool(call.name,args,()=>this.localTool(call.name,args,this.current!));
