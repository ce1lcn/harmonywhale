 // 0.8.4 B1：超大工具输出（默认超过 16 KB）转存为会话文件，上下文里只留头尾预览、总长度和 fileId。转存失败时保留原输出，不影响任务。
 // web_fetch 的正文在 JSON 的 text 字段里，转存可读正文并保持 JSON 合法；其他工具整体转存。
 async spillOutput(name:string,output:string,session:Session,callId:string):Promise<string>{
  const threshold:number=thresholdOf(this.state.spillThreshold);
  try{
   if(name==='web_fetch'&&!output.startsWith('没能联网核实')){
    const page=JSON.parse(output) as WebPage;
    if(typeof page.text!=='string'||page.text.length<=threshold)return output;
    const asset=await this.files.spillText(session,'web_fetch',webFileText(page),callId);
    return webSpillResult(page,asset.id,asset.name);
   }
   if(!shouldSpill(name,output,threshold)||output.startsWith('没能联网核实'))return output;
   const asset=await this.files.spillText(session,name,output,callId);
   return spillResult(output,asset.id,asset.name);
  }catch(e){return output;}
 }
