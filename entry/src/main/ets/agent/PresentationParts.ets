import {SlideSpec} from './OfficeFormats';
import {escapeXml} from './OfficeXml';
const d='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>';
const ns='http://schemas.openxmlformats.org/';
const pns='xmlns:a="'+ns+'drawingml/2006/main" xmlns:r="'+ns+'officeDocument/2006/relationships" xmlns:p="'+ns+'presentationml/2006/main"';
const group='<p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr>';
function rel(id:string,type:string,target:string):string{return '<Relationship Id="'+id+'" Type="'+ns+'officeDocument/2006/relationships/'+type+'" Target="'+target+'"/>';}
function relationships(body:string):string{return d+'<Relationships xmlns="'+ns+'package/2006/relationships">'+body+'</Relationships>';}
function paragraph(value:string,size:number,color:string,bold:boolean):string{return '<a:p><a:pPr'+(size===2000?' marL="300000" indent="-200000"':'')+'><a:lnSpc><a:spcPct val="115000"/></a:lnSpc><a:spcAft><a:spcPts val="800"/></a:spcAft>'+ (size===2000?'<a:buChar char="•"/>':'')+'</a:pPr><a:r><a:rPr lang="zh-CN" sz="'+size+'"'+(bold?' b="1"':'')+'><a:solidFill><a:srgbClr val="'+color+'"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Microsoft YaHei"/></a:rPr><a:t>'+escapeXml(value)+'</a:t></a:r><a:endParaRPr lang="zh-CN" sz="'+size+'"/></a:p>';}
function shape(id:number,name:string,y:number,height:number,text:string,size:number,color:string,bold:boolean):string{return '<p:sp><p:nvSpPr><p:cNvPr id="'+id+'" name="'+name+'"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="650000" y="'+y+'"/><a:ext cx="10892000" cy="'+height+'"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0"/><a:lstStyle/>'+text.split('\n').map(v=>paragraph(v,size,color,bold)).join('')+'</p:txBody></p:sp>';}
export function newPresentation(slides:SlideSpec[]):Record<string,string>{if(!slides.length||slides.length>20)throw new Error('基础PPT支持1～20页');slides.forEach(s=>{if(typeof s.title!=='string'||typeof s.body!=='string'||!s.title.trim()||s.title.length>60||s.body.length>600)throw new Error('每页需标题，标题最多60字、正文最多600字');const lines=s.body.split('\n').reduce((n:number,line:string)=>n+Math.max(1,Math.ceil(line.split('').reduce((u:number,c:string)=>u+(c.charCodeAt(0)>255?2:1),0)/72)),0);if(lines>12)throw new Error('正文过长，请拆为更多页');});const parts:Record<string,string>={};let overrides='<Override PartName="/ppt/presentation.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml"/><Override PartName="/ppt/slideMasters/slideMaster1.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slideMaster+xml"/><Override PartName="/ppt/slideLayouts/slideLayout1.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slideLayout+xml"/><Override PartName="/ppt/theme/theme1.xml" ContentType="application/vnd.openxmlformats-officedocument.theme+xml"/>';let ids='',rels=rel('rId1','slideMaster','slideMasters/slideMaster1.xml');
 slides.forEach((s,i)=>{const n=i+1;ids+='<p:sldId id="'+(256+i)+'" r:id="rId'+(i+2)+'"/>';rels+=rel('rId'+(i+2),'slide','slides/slide'+n+'.xml');overrides+='<Override PartName="/ppt/slides/slide'+n+'.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slide+xml"/>';parts['ppt/slides/slide'+n+'.xml']=d+'<p:sld '+pns+'><p:cSld><p:bg><p:bgPr><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill><a:effectLst/></p:bgPr></p:bg><p:spTree>'+group+shape(2,'Title',500000,1200000,s.title,2800,'172033',true)+shape(3,'Body',1950000,4350000,s.body,2000,'374151',false)+shape(4,'Page',6450000,260000,String(n),1100,'64748B',false)+'</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>';parts['ppt/slides/_rels/slide'+n+'.xml.rels']=relationships(rel('rId1','slideLayout','../slideLayouts/slideLayout1.xml'));});
 parts['[Content_Types].xml']=d+'<Types xmlns="'+ns+'package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/>'+overrides+'</Types>';
 parts['_rels/.rels']=relationships(rel('rId1','officeDocument','ppt/presentation.xml'));
 parts['ppt/presentation.xml']=d+'<p:presentation '+pns+'><p:sldMasterIdLst><p:sldMasterId id="2147483648" r:id="rId1"/></p:sldMasterIdLst><p:sldIdLst>'+ids+'</p:sldIdLst><p:sldSz cx="12192000" cy="6858000" type="screen16x9"/><p:notesSz cx="6858000" cy="9144000"/></p:presentation>';
 parts['ppt/_rels/presentation.xml.rels']=relationships(rels);
 parts['ppt/slideLayouts/slideLayout1.xml']=d+'<p:sldLayout '+pns+' type="blank" preserve="1"><p:cSld name="Blank"><p:spTree>'+group+'</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sldLayout>';
 parts['ppt/slideLayouts/_rels/slideLayout1.xml.rels']=relationships(rel('rId1','slideMaster','../slideMasters/slideMaster1.xml'));
 parts['ppt/slideMasters/slideMaster1.xml']=d+'<p:sldMaster '+pns+'><p:cSld><p:spTree>'+group+'</p:spTree></p:cSld><p:clrMap accent1="accent1" accent2="accent2" accent3="accent3" accent4="accent4" accent5="accent5" accent6="accent6" bg1="lt1" bg2="lt2" folHlink="folHlink" hlink="hlink" tx1="dk1" tx2="dk2"/><p:sldLayoutIdLst><p:sldLayoutId id="2147483649" r:id="rId1"/></p:sldLayoutIdLst><p:txStyles><p:titleStyle/><p:bodyStyle/><p:otherStyle/></p:txStyles></p:sldMaster>';
 parts['ppt/slideMasters/_rels/slideMaster1.xml.rels']=relationships(rel('rId1','slideLayout','../slideLayouts/slideLayout1.xml')+rel('rId2','theme','../theme/theme1.xml'));
 const colors=['172033','FFFFFF','374151','F1F5F9','2563EB','0D9488','F59E0B','EF4444','8B5CF6','64748B','2563EB','7C3AED'],names=['dk1','lt1','dk2','lt2','accent1','accent2','accent3','accent4','accent5','accent6','hlink','folHlink'];const fill='<a:solidFill><a:schemeClr val="phClr"/></a:solidFill>';const line='<a:ln w="12700"><a:solidFill><a:schemeClr val="phClr"/></a:solidFill><a:prstDash val="solid"/></a:ln>';
 parts['ppt/theme/theme1.xml']=d+'<a:theme xmlns:a="'+ns+'drawingml/2006/main" name="HarmonyWhale"><a:themeElements><a:clrScheme name="Whale">'+names.map((n,i)=>'<a:'+n+'><a:srgbClr val="'+colors[i]+'"/></a:'+n+'>').join('')+'</a:clrScheme><a:fontScheme name="Whale"><a:majorFont><a:latin typeface="Arial"/><a:ea typeface="Microsoft YaHei"/><a:cs typeface="Arial"/></a:majorFont><a:minorFont><a:latin typeface="Arial"/><a:ea typeface="Microsoft YaHei"/><a:cs typeface="Arial"/></a:minorFont></a:fontScheme><a:fmtScheme name="Whale"><a:fillStyleLst>'+fill.repeat(3)+'</a:fillStyleLst><a:lnStyleLst>'+line.repeat(3)+'</a:lnStyleLst><a:effectStyleLst><a:effectStyle><a:effectLst/></a:effectStyle><a:effectStyle><a:effectLst/></a:effectStyle><a:effectStyle><a:effectLst/></a:effectStyle></a:effectStyleLst><a:bgFillStyleLst>'+fill.repeat(3)+'</a:bgFillStyleLst></a:fmtScheme></a:themeElements><a:objectDefaults/><a:extraClrSchemeLst/></a:theme>';
 return parts;
}
