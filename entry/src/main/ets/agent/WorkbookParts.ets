import {newSheet,GridValue,cellXml,CellPatch,updateSheet,PartReader,sheetRead} from './OfficeFormats';
import {escapeXml,parseXml,child,descendants} from './OfficeXml';
export interface FormulaCell {formula:string;}
export type WorkbookCell=GridValue|FormulaCell;
export interface WorksheetSpec {name:string;rows:WorkbookCell[][];widths?:number[];headerBold?:boolean;}
function column(n:number):string {let out='';for(n++;n>0;n=Math.floor((n-1)/26))out=String.fromCharCode(65+(n-1)%26)+out;return out;}
export function formulaXml(ref:string,value:string,style?:string):string {if(!value.trim()||value.length>32000)throw new Error('公式文本无效');cellXml(ref,'empty','');return '<c r="'+ref+'"'+(style?' s="'+style+'"':'')+'><f>'+escapeXml(value.replace(/^=/,''))+'</f></c>';}
export function newWorkbook(spec:WorksheetSpec[]):Record<string,string>{
 if(!Array.isArray(spec)||!spec.length||spec.length>20)throw new Error('工作簿支持1～20张工作表');const names:string[]=[];const out:Record<string,string>={};let ids='',rels='',types='';
 spec.forEach((s,i)=>{if(names.includes(s.name.toLowerCase()))throw new Error('工作表名称重复');names.push(s.name.toLowerCase());if(!Array.isArray(s.rows)||s.rows.some(r=>!Array.isArray(r)))throw new Error('rows必须是二维数组，每行用数组包住；不能直接传字符串行');if(!Array.isArray(s.rows)||!s.rows.length||s.rows.length>2000||s.rows.some(r=>!Array.isArray(r)||r.length>100))throw new Error('每张表最多2000行100列');const seed=newSheet([[null]],s.name);if(i===0)Object.keys(seed).forEach(k=>out[k]=seed[k]);
 const body=s.rows.map((r,y)=>'<row r="'+(y+1)+'">'+r.map((v,x)=>{const style=y===0&&s.headerBold!==false?'1':'0';if(v===null)return '';if(typeof v==='object')return formulaXml(column(x)+(y+1),v.formula,style);return cellXml(column(x)+(y+1),typeof v==='string'?'text':typeof v==='number'?'number':'boolean',String(v),style);}).join('')+'</row>').join('');
 const widths=s.widths??[];if(widths.length>100||widths.some(w=>!Number.isFinite(w)||w<1||w>255))throw new Error('列宽须在1～255');const cols=widths.length?'<cols>'+widths.map((w,x)=>'<col min="'+(x+1)+'" max="'+(x+1)+'" width="'+w+'" customWidth="1"/>').join('')+'</cols>':'';
 out['xl/worksheets/sheet'+(i+1)+'.xml']=seed['xl/worksheets/sheet1.xml'].replace(/<sheetData>[\s\S]*?<\/sheetData>/,cols+'<sheetData>'+body+'</sheetData>');
 ids+='<sheet name="'+escapeXml(s.name)+'" sheetId="'+(i+1)+'" r:id="rId'+(i+1)+'"/>';rels+='<Relationship Id="rId'+(i+1)+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet'+(i+1)+'.xml"/>';types+='<Override PartName="/xl/worksheets/sheet'+(i+1)+'.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';});
 out['xl/workbook.xml']=out['xl/workbook.xml'].replace(/<sheets>[\s\S]*?<\/sheets>/,'<sheets>'+ids+'</sheets>');out['xl/_rels/workbook.xml.rels']=out['xl/_rels/workbook.xml.rels'].replace(/<Relationship\b[^>]*Type="[^"]*\/worksheet"[^>]*\/>/g,'').replace('Id="rId2"','Id="rIdStyles"').replace('</Relationships>',rels+'</Relationships>');out['[Content_Types].xml']=out['[Content_Types].xml'].replace(/<Override[^>]*PartName="\/xl\/worksheets\/sheet1.xml"[^>]*\/>/,'').replace('</Types>',types+'</Types>');return out;
}
export function patchWorkbookSheet(xml:string,patches:CellPatch[]):string {const normal=patches.map(p=>p.type==='formula'?{cell:p.cell,type:'empty',value:''} as CellPatch:p);let result=updateSheet(xml,normal);patches.filter(p=>p.type==='formula').forEach(p=>{const n=descendants(parseXml(result),'c').find(c=>c.attrs.r===p.cell)!;result=result.slice(0,n.start)+formulaXml(p.cell,p.value,n.attrs.s)+result.slice(n.end);});return result;}
export function appendWorksheet(reader:PartReader,name:string,rows:WorkbookCell[][]):CellPatch[]{if(!Array.isArray(rows)||!rows.length||rows.length>100)throw new Error('每次追加1～100行');const cells=sheetRead(reader,name).cells;const max=cells.reduce((n:number,c)=>Math.max(n,Number(c.cell.replace(/^[A-Z]+/,''))),0);const patches:CellPatch[]=[];rows.forEach((r,y)=>{if(!Array.isArray(r)||r.length>100)throw new Error('追加行最多100列');r.forEach((v,x)=>{if(v!==null)patches.push({cell:column(x)+(max+y+1),type:typeof v==='object'?'formula':typeof v==='string'?'text':typeof v==='number'?'number':'boolean',value:typeof v==='object'?v.formula:String(v)});});});if(patches.length>100)throw new Error('每次追加最多100个非空单元格');return patches;}
