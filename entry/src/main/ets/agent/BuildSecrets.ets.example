// 复制本文件为同目录下的 BuildSecrets.ets，再填入自己的值。
//
// ⚠️ 这三个都是**编译期常量**：填进去的字符串会原样进入源码与编译产物（HAP）。
//    运行时把值转存到 HUKS 只是让应用在沙箱里加密保存，并不能抹掉已经编译进去的明文。
//    因此：公开的源码与公开分发的 HAP 都**不得**内置任何私人密钥。
//    BuildSecrets.ets 已被 .gitignore 忽略，切勿提交。
//
// 本地构建也可以由 scripts/build-secrets.cjs 从工程外的 JSON5 文件生成，避免手写常量。

export const APP_VERSION: string = '';

/** 联网搜索服务的 API Key；留空时使用无 Key 的降级搜索通道 */
export const BOCHA_KEY: string = '';

/** 与沙箱内已保存值比较的标记；变化时会用 BOCHA_KEY 覆盖安全存储里的旧值 */
export const SEARCH_SEED: string = '';
