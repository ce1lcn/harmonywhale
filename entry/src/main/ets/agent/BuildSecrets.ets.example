// 复制本文件为同目录下的 BuildSecrets.ets，再填入自己的值。
// BuildSecrets.ets 已被 .gitignore 忽略，不要提交真实密钥。
// 这些常量会在运行时写入应用沙箱的安全存储（HUKS），源码里不保留明文。

export const APP_VERSION: string = '';

/** 联网搜索服务（博查）的 API Key；留空时使用无 Key 的降级搜索通道 */
export const BOCHA_KEY: string = '';

/** 与沙箱内已保存值比较的标记；变化时会用 BOCHA_KEY 覆盖安全存储里的旧值 */
export const SEARCH_SEED: string = '';
