import {XmlNode,parseXml,descendants,child,textOf,escapeXml} from './OfficeXml';
export interface PartReader {read:(path:string)=>string;exists:(path:string)=>boolean;}
export interface SheetInfo {name:string;path:string;}
export interface CellValue {cell:string;value:string;type:string;formula?:string;}
export interface SheetData {name:string;cells:CellValue[];merged:string[];truncated:boolean;note:string;}
export interface CellPatch {cell:string;type:string;value:string;}
export interface TextBlock {id:string;text:string;}
export interface SlideData {slide:number;path:string;paragraphs:TextBlock[];}
export interface SlideSpec {title:string;body:string;}
export type GridValue=string|number|boolean|null;
export function partPath(base:string,target:string):string {if(!target||/[\\?#:\u0000]/.test(target))throw new Error('Office引用路径不支持');const parts:string[]=(target.startsWith('/')?target.slice(1):base+'/'+target).split('/');const out:string[]=[];parts.forEach(s=>{if(!s||s==='.')return;if(s==='..'){if(!out.length)throw new Error('Office引用越界');out.pop();}else out.push(s);});return out.join('/');}
function relationship(reader:PartReader,path:string):Map<string,string>{const map=new Map<string,string>();descendants(parseXml(reader.read(path)),'Relationship').forEach(r=>{if(r.attrs.TargetMode!=='External')map.set(r.attrs.Id,r.attrs.Target);});return map;}
export function sheets(reader:PartReader):SheetInfo[]{const rels=relationship(reader,'xl/_rels/workbook.xml.rels');return descendants(parseXml(reader.read('xl/workbook.xml')),'sheet').map(n=>{const target=rels.get(n.attrs['r:id']);if(!target)throw new Error('工作表引用缺失');const path=partPath('xl',target);if(!path.startsWith('xl/worksheets/'))throw new Error('本版不支持图表工作表');return {name:n.attrs.name,path:path} as SheetInfo;});}
function richText(n:XmlNode):string{if(n.local==='rPh')return '';return n.local==='t'?textOf(n):n.children.map(c=>richText(c)).join('');}
export function sheetRead(reader:PartReader,name:string):SheetData {const info=sheets(reader).find(s=>s.name===name);if(!info)throw new Error('工作表不存在');const strings=reader.exists('xl/sharedStrings.xml')?descendants(parseXml(reader.read('xl/sharedStrings.xml')),'si').map(n=>richText(n)):[];const tree=parseXml(reader.read(info.path));const nodes=descendants(tree,'c');const cells:CellValue[]=nodes.slice(0,200000).map(n=>{const type=n.attrs.t??'n';const v=child(n,'v')?.text??'';let value=type==='s'?strings[Number(v)]:type==='inlineStr'?richText(n):v;if(value===undefined)throw new Error('共享字符串索引无效');return {cell:n.attrs.r,value:value,type:type,formula:child(n,'f')?.text} as CellValue;});return {name:name,cells:cells,merged:descendants(tree,'mergeCell').map(n=>n.attrs.ref),truncated:nodes.length>200000,note:'数值为原始存储值，日期/货币格式未渲染；公式缓存不作为重新计算结果。'};}
function column(ref:string):number {const letters=/^[A-Z]+/.exec(ref)?.[0]??'';let n=0;for(let i=0;i<letters.length;i++)n=n*26+letters.charCodeAt(i)-64;return n;}
export function cellRef(value:string):boolean{return /^[A-Z]{1,3}[1-9]\d{0,6}$/.test(value)&&column(value)<=16384&&Number(value.replace(/^[A-Z]+/,''))<=1048576;}
export function cellXml(ref:string,type:string,value:string,style?:string):string {if(!cellRef(ref))throw new Error('单元格地址无效');if(value.length>32000)throw new Error('单元格文字过长');const common=' r="'+ref+'"'+(style?' s="'+escapeXml(style)+'"':'');if(type==='empty')return '<c'+common+'/>';if(type==='number'){if(!value.trim()||!Number.isFinite(Number(value)))throw new Error('单元格数值无效');return '<c'+common+'><v>'+Number(value)+'</v></c>';}if(type==='boolean'){if(!['true','false'].includes(value))throw new Error('布尔值应为true或false');return '<c'+common+' t="b"><v>'+(value==='true'?'1':'0')+'</v></c>';}if(type!=='text')throw new Error('本版只写入text/number/boolean/empty，不执行公式');return '<c'+common+' t="inlineStr"><is><t xml:space="preserve">'+escapeXml(value)+'</t></is></c>';}
export function updateSheet(source:string,patches:CellPatch[]):string {if(!patches.length||patches.length>100)throw new Error('每次修改1～100个单元格');let xml=source;const seen:string[]=[];patches.forEach(p=>{if(typeof p.cell!=='string'||typeof p.type!=='string'||typeof p.value!=='string')throw new Error('单元格修改参数无效');if(seen.includes(p.cell))throw new Error('重复修改同一单元格');seen.push(p.cell);const tree=parseXml(xml);if(tree.name.includes(':'))throw new Error('本版不修改带命名空间前缀的工作表');const data=child(tree,'sheetData');if(!data)throw new Error('缺少sheetData');const rowNumber=Number(p.cell.replace(/^[A-Z]+/,''));const merged=descendants(tree,'mergeCell').find(n=>{const ends=n.attrs.ref.split(':');const a=ends[0],b=ends[1];return b&&Number(a.replace(/^[A-Z]+/,''))<=rowNumber&&Number(b.replace(/^[A-Z]+/,''))>=rowNumber&&column(a)<=column(p.cell)&&column(b)>=column(p.cell)&&a!==p.cell;});if(merged)throw new Error('只能修改合并区域左上角');const target=descendants(data,'c').find(n=>n.attrs.r===p.cell);const replacement=cellXml(p.cell,p.type,p.value,target?.attrs.s);if(target){xml=xml.slice(0,target.start)+replacement+xml.slice(target.end);return;}const row=data.children.find(n=>n.local==='row'&&Number(n.attrs.r)===rowNumber);if(row){if(xml.slice(row.start,row.end).trim().endsWith('/>')){xml=xml.slice(0,row.start)+'<row r="'+rowNumber+'">'+replacement+'</row>'+xml.slice(row.end);return;}const next=row.children.find(n=>n.local==='c'&&column(n.attrs.r)>column(p.cell));const at=next?.start??row.innerEnd;xml=xml.slice(0,at)+replacement+xml.slice(at);return;}const newRow='<row r="'+rowNumber+'">'+replacement+'</row>';if(xml.slice(data.start,data.end).trim().endsWith('/>')){xml=xml.slice(0,data.start)+'<sheetData>'+newRow+'</sheetData>'+xml.slice(data.end);return;}const next=data.children.find(n=>n.local==='row'&&Number(n.attrs.r)>rowNumber);const at=next?.start??data.innerEnd;xml=xml.slice(0,at)+newRow+xml.slice(at);});const tree=parseXml(xml);const dimension=child(tree,'dimension');if(dimension)xml=xml.slice(0,dimension.start)+xml.slice(dimension.end);return xml;}
export function invalidateFormulaCache(source:string):string{let out=source;descendants(parseXml(source),'c').filter(n=>!!child(n,'f')).sort((a:XmlNode,b:XmlNode)=>b.start-a.start).forEach(n=>{const v=child(n,'v');if(v)out=out.slice(0,v.start)+out.slice(v.end);});return out;}
export function calculationOnOpen(source:string):string {const tree=parseXml(source);const old=child(tree,'calcPr');const tag='<calcPr calcMode="auto" fullCalcOnLoad="1" forceFullCalc="1"/>';return old?source.slice(0,old.start)+tag+source.slice(old.end):source.slice(0,tree.innerEnd)+tag+source.slice(tree.innerEnd);}
export function slides(reader:PartReader):string[]{const rels=relationship(reader,'ppt/_rels/presentation.xml.rels');return descendants(parseXml(reader.read('ppt/presentation.xml')),'sldId').map(n=>{const target=rels.get(n.attrs['r:id']);if(!target)throw new Error('幻灯片引用缺失');const path=partPath('ppt',target);if(!path.startsWith('ppt/slides/'))throw new Error('幻灯片路径不支持');return path;});}
export function slideRead(reader:PartReader,index:number):SlideData{const path=slides(reader)[index-1];if(!path)throw new Error('幻灯片页码不存在');const root=parseXml(reader.read(path));const paragraphs=descendants(root,'p').map((p,i)=>{return {id:'p'+(i+1),text:richText(p)} as TextBlock;}).filter(p=>!!p.text);return {slide:index,path:path,paragraphs:paragraphs};}
export function updateSlide(source:string,paragraph:string,value:string):string {if(value.length>10000)throw new Error('幻灯片文本过长');const index=Number(paragraph.replace(/^p/,''))-1;if(!/^p[1-9]\d*$/.test(paragraph))throw new Error('段落编号无效');const node=descendants(parseXml(source),'p')[index];if(!node)throw new Error('段落不存在');const texts=descendants(node,'t');if(!texts.length)throw new Error('段落不可直接替换');let out=source;texts.slice().reverse().forEach(n=>{const text=n===texts[0]?escapeXml(value):'';if(source.slice(n.start,n.end).trim().endsWith('/>'))out=out.slice(0,n.start)+'<'+n.name+'>'+text+'</'+n.name+'>'+out.slice(n.end);else out=out.slice(0,n.innerStart)+text+out.slice(n.innerEnd);});parseXml(out);return out;}
function col(index:number):string{let s='';for(let n=index+1;n>0;n=Math.floor((n-1)/26))s=String.fromCharCode(65+(n-1)%26)+s;return s;}
const declaration='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>';
const ns='http://schemas.openxmlformats.org/';
export function newSheet(rows:GridValue[][],name:string):Record<string,string>{if(!rows.length||rows.length>500||rows.some(r=>!Array.isArray(r)||r.length>40))throw new Error('新表格限制500行、40列');if(!name||name.length>31||/[\\/?*\[\]:]/.test(name))throw new Error('工作表名称无效');const data=rows.map((row,i)=>'<row r="'+(i+1)+'">'+row.map((v,j)=>{if(v===null)return '';if(!['string','number','boolean'].includes(typeof v))throw new Error('表格值类型不支持');return cellXml(col(j)+(i+1),typeof v==='string'?'text':typeof v==='number'?'number':'boolean',String(v),i===0?'1':'0');}).join('')+'</row>').join('');return {
 '[Content_Types].xml':declaration+'<Types xmlns="'+ns+'package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/></Types>',
 '_rels/.rels':declaration+'<Relationships xmlns="'+ns+'package/2006/relationships"><Relationship Id="rId1" Type="'+ns+'officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>',
 'xl/workbook.xml':declaration+'<workbook xmlns="'+ns+'spreadsheetml/2006/main" xmlns:r="'+ns+'officeDocument/2006/relationships"><sheets><sheet name="'+escapeXml(name)+'" sheetId="1" r:id="rId1"/></sheets><calcPr calcMode="auto" fullCalcOnLoad="1"/></workbook>',
 'xl/_rels/workbook.xml.rels':declaration+'<Relationships xmlns="'+ns+'package/2006/relationships"><Relationship Id="rId1" Type="'+ns+'officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/><Relationship Id="rId2" Type="'+ns+'officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>',
 'xl/worksheets/sheet1.xml':declaration+'<worksheet xmlns="'+ns+'spreadsheetml/2006/main"><sheetViews><sheetView workbookViewId="0"><pane ySplit="1" topLeftCell="A2" state="frozen"/></sheetView></sheetViews><sheetFormatPr defaultRowHeight="20"/><cols><col min="1" max="40" width="20" customWidth="1"/></cols><sheetData>'+data+'</sheetData></worksheet>',
 'xl/styles.xml':declaration+'<styleSheet xmlns="'+ns+'spreadsheetml/2006/main"><fonts count="2"><font><sz val="11"/><name val="Arial"/></font><font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="Arial"/></font></fonts><fills count="3"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill><fill><patternFill patternType="solid"><fgColor rgb="FF2563EB"/><bgColor indexed="64"/></patternFill></fill></fills><borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="1" fillId="2" borderId="0" xfId="0" applyFont="1" applyFill="1"/></cellXfs><cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>'};}
