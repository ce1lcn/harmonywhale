import {Definition,Schema} from './Types';
export function harnessDefinitions(disabled:string[]):Definition[]{const plan:Schema={type:'object',properties:{},required:['text','stepsJson']};plan.properties.text={type:'string',description:'完整计划，包含步骤、依赖和完成标准'};plan.properties.stepsJson={type:'string',description:'1～20项步骤标题的JSON字符串数组'};const step:Schema={type:'object',properties:{},required:['stepId','stepStatus']};step.properties.stepId={type:'string'};step.properties.stepStatus={type:'string',enum:['pending','running','completed','blocked']};step.properties.evidence={type:'string'};step.properties.snapshotId={type:'string'};return [{name:'submit_plan',description:'保存计划草案，不开始执行',parameters:plan,source:'Harness',enabled:!disabled.includes('submit_plan'),readOnly:true},{name:'update_plan_step',description:'更新已批准计划的步骤进度；完成必须引用本轮核验证据',parameters:step,source:'Harness',enabled:!disabled.includes('update_plan_step'),readOnly:false}];}
